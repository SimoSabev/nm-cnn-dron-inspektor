flowchart TB
    D0["Concrete Crack Images<br/>40 000 плочки 227×227<br/>20 000 Positive / 20 000 Negative"] --> S{"Стратифицирано разделяне<br/>seed = 42"}
    S -->|70 %| TR["Обучаващо 28 000"]
    S -->|15 %| VA["Валидационно 6 000<br/>ранно спиране · избор на праг"]
    S -->|15 %| TE["Тестово 6 000<br/>🔒 използва се веднъж"]
    TR --> AUG["Аугментация<br/>огледало · rot90 · яркост · контраст"]
    AUG --> M1["Собствен CNN<br/>4 блока Conv-BN-ReLU · GAP<br/>Dropout · L2 · Adam 1e-3"]
    AUG --> M2a["MobileNetV2 (ImageNet)<br/>етап 1: замразена основа<br/>обучава се само главата"]
    M2a --> M2b["етап 2: фино настройване<br/>последните 30 слоя · Adam 1e-5"]
    VA -.-> M1
    VA -.-> M2b
    M1 --> TH["Избор на праг по валидационното<br/>най-висок праг с пълнота ≥ 99 %"]
    M2b --> TH
    VA --> TH
    TH --> EV["Оценка върху тестовото<br/>матрица на объркванията<br/>прецизност · пълнота · F1 · ROC-AUC"]
    TE --> EV
    EV --> BEST["По-добрият модел по пълнота<br/>→ конвейер"]
